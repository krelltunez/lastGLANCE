{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "com.lastglance.streamdeck.sdPlugin/bin"
  },
  "include": ["src", "../electron/deckProtocol.ts"],
  "exclude": ["src/**/*.test.ts"]
}
