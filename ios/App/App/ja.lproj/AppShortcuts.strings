/* App Shortcut phrases. The legacy .strings form, not a String
   Catalog: appshortcutstringsprocessor rejects AppShortcuts.xcstrings
   whenever the APP TARGET deploys below iOS 17, and this one stays at
   15.0 so iPhones that cannot run the widgets can still run the app.
   Keys are the English phrase with ${applicationName} where the Swift
   interpolates \(.applicationName). */

"Add a chore in ${applicationName}" = "${applicationName}でタスクを追加";
"Check a chore in ${applicationName}" = "${applicationName}でタスクを確認";
"Log a chore in ${applicationName}" = "${applicationName}でタスクを記録";
"Mark a chore done in ${applicationName}" = "${applicationName}でタスクを完了にする";
"New chore in ${applicationName}" = "${applicationName}で新しいタスクを作成";
"Show chores due soon in ${applicationName}" = "${applicationName}で予定日が近いタスクを表示";
"What is due soon in ${applicationName}" = "${applicationName}でもうすぐやることを教えて";
"When did I last do a chore in ${applicationName}" = "${applicationName}でタスクを最後にやったのはいつ";
