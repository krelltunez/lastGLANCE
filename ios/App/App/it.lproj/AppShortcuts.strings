/* App Shortcut phrases. The legacy .strings form, not a String
   Catalog: appshortcutstringsprocessor rejects AppShortcuts.xcstrings
   whenever the APP TARGET deploys below iOS 17, and this one stays at
   15.0 so iPhones that cannot run the widgets can still run the app.
   Keys are the English phrase with ${applicationName} where the Swift
   interpolates \(.applicationName). */

"Add a chore in ${applicationName}" = "Aggiungi un'attività in ${applicationName}";
"Check a chore in ${applicationName}" = "Controlla un'attività in ${applicationName}";
"Log a chore in ${applicationName}" = "Registra un'attività in ${applicationName}";
"Mark a chore done in ${applicationName}" = "Segna un'attività come fatta in ${applicationName}";
"New chore in ${applicationName}" = "Nuova attività in ${applicationName}";
"Show chores due soon in ${applicationName}" = "Mostra le attività in scadenza in ${applicationName}";
"What is due soon in ${applicationName}" = "Cosa scade presto in ${applicationName}";
"When did I last do a chore in ${applicationName}" = "Quando ho fatto un'attività l'ultima volta in ${applicationName}";
