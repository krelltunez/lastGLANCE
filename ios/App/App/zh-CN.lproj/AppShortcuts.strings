/* App Shortcut phrases. The legacy .strings form, not a String
   Catalog: appshortcutstringsprocessor rejects AppShortcuts.xcstrings
   whenever the APP TARGET deploys below iOS 17, and this one stays at
   15.0 so iPhones that cannot run the widgets can still run the app.
   Keys are the English phrase with ${applicationName} where the Swift
   interpolates \(.applicationName). */

"Add a chore in ${applicationName}" = "在 ${applicationName} 中添加事项";
"Check a chore in ${applicationName}" = "在 ${applicationName} 中查看事项";
"Log a chore in ${applicationName}" = "在 ${applicationName} 中记录事项";
"Mark a chore done in ${applicationName}" = "在 ${applicationName} 中标记事项完成";
"New chore in ${applicationName}" = "在 ${applicationName} 中新建事项";
"Show chores due soon in ${applicationName}" = "在 ${applicationName} 中显示近期到期的事项";
"What is due soon in ${applicationName}" = "${applicationName} 中有什么快到期了";
"When did I last do a chore in ${applicationName}" = "我上次在 ${applicationName} 中做某件事项是什么时候";
