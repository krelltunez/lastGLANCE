/* App Shortcut phrases. The legacy .strings form, not a String
   Catalog: appshortcutstringsprocessor rejects AppShortcuts.xcstrings
   whenever the APP TARGET deploys below iOS 17, and this one stays at
   15.0 so iPhones that cannot run the widgets can still run the app.
   Keys are the English phrase with ${applicationName} where the Swift
   interpolates \(.applicationName). */

"Add a chore in ${applicationName}" = "Add a chore in ${applicationName}";
"Check a chore in ${applicationName}" = "Check a chore in ${applicationName}";
"Log a chore in ${applicationName}" = "Log a chore in ${applicationName}";
"Mark a chore done in ${applicationName}" = "Mark a chore done in ${applicationName}";
"New chore in ${applicationName}" = "New chore in ${applicationName}";
"Show chores due soon in ${applicationName}" = "Show chores due soon in ${applicationName}";
"What is due soon in ${applicationName}" = "What is due soon in ${applicationName}";
"When did I last do a chore in ${applicationName}" = "When did I last do a chore in ${applicationName}";
